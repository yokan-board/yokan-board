# Yokan Board Deployment Configuration
# Copy this file to .env and adjust the paths to match your system

# Absolute path to the source code repository
PROJECT_ROOT="/Users/julian/dev/yokan/yokan-board"

# Path to the Docker Compose directories
COMPOSE_DIR="/Users/julian/dc/yokan-board"
WIN_COMPOSE_DIR="/Users/julian/dc/yokan-win-board"

# Database paths (relative to host)
DB_PATH="/Users/julian/dc/yokan-board/server/data/db.sqlite"
BACKUP_DIR="/Users/julian/dc/yokan-board/server/data/backup"

# Docker Image Configuration
SERVER_IMAGE="yokanboard/yokan-server"
CLIENT_IMAGE="yokanboard/yokan-client"
TAG="dev"

# Health Check
HEALTH_CHECK_URL="https://yokan.win/login"
